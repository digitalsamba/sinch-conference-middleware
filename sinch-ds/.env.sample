# Copy to .env (never commit it). `npm start` loads it; Docker uses --env-file.

# --- Sinch (dashboard -> Voice -> Apps) ---
# Used to verify callback signatures on /VoiceEvent and to call the Calling API.
SINCH_APPLICATION_KEY=
SINCH_APPLICATION_SECRET=
# Optional, default europe. One of: global, europe, northAmerica, southAmerica,
# asiaSouthEast1, asiaSouthEast2. Must match where your conferences are hosted.
SINCH_REGION=europe

# --- Digital Samba ---
# Developer key (Team settings -> Developer). Required if any PIN map entry has a dsRoomId.
DIGITAL_SAMBA_DEVELOPER_KEY=
# Optional, default https://api.digitalsamba.com
DIGITAL_SAMBA_API_URL=https://api.digitalsamba.com
# Required. DS sends it as "Authorization: Bearer <secret>" to /DigitalSambaListener.
# Generate one: openssl rand -hex 32
DIGITAL_SAMBA_WEBHOOK_SECRET=
# Optional, default true. false = don't send callers' numbers to Digital Samba.
SEND_CALLER_NUMBER=true

# --- This service ---
# Optional, default pins.json (relative to the working directory). The Docker image
# defaults to /config/pins.json. Start from pins.example.json.
PIN_MAP_FILE=pins.json
# Optional, default 3030.
PORT=3030
# Local experiments only: start without DIGITAL_SAMBA_WEBHOOK_SECRET, leaving
# /DigitalSambaListener unauthenticated. Never set this on a reachable host.
# ALLOW_INSECURE_DEV=true
