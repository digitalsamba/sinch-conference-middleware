# Express related configuration
# NB: the variable is PORT (uppercase) — src/server.js reads process.env.PORT.
# A lowercase `port` is ignored and the app silently falls back to 3030.
PORT=3030

# Sinch Application credentials for Voice API
SINCH_APPLICATION_KEY=
SINCH_APPLICATION_SECRET=
# Optional. One of: global, europe, northAmerica, southAmerica,
# asiaSouthEast1, asiaSouthEast2. Defaults to europe. Only change this if the
# room SIP will be connecting from a non-European trunk.
SINCH_REGION=europe

# Digital Samba Configuration
DIGITAL_SAMBA_API_URL=https://api.digitalsamba.com
DIGITAL_SAMBA_DEVELOPER_KEY=
# Shared secret authenticating inbound Digital Samba webhook calls to
# /DigitalSambaListener (sent as "Authorization: Bearer <secret>").
# Use a long random value; the old default "DigitalSambaListener" is public.
DIGITAL_SAMBA_WEBHOOK_SECRET=

# HTTP Basic credentials for the web UI, /api/* and the live log stream.
# If unset, the UI and /api/* answer 503 (the webhooks keep working).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Local demos only: leave the UI and /api/* open to anyone who can reach the port.
# ADMIN_AUTH_DISABLED=true
# Optional, comma-separated origins allowed to call /api/* cross-origin.
# CORS_ORIGIN=

# Optional. Where the SQLite database lives. Defaults to ./conference_data.db,
# which inside a container is lost on every recreate — compose.yaml overrides
# this to a path on a named volume.
DATABASE_PATH=./conference_data.db

# Optional. Pass the caller's number through to the room.
SEND_CALLER_NUMBER=false
